APP_ENV=development
SECRET_KEY=your-backend-secret-key-change-in-production
DATABASE_URL=postgresql+psycopg2://devmeet:devmeet@localhost:5432/devmeet_db

# Google OAuth Settings
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# n8n Infrastructure & Webhook Settings
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=your-n8n-encryption-key-min-32-chars
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh
N8N_WEBHOOK_URL=http://localhost:5678/webhook/devmeet-meeting-ai
DEVMEET_WEBHOOK_SECRET=your-devmeet-webhook-secret-key-min-32-chars

# Google Sheets Integration Settings
DEVMEET_SPREADSHEET_ID=your-google-spreadsheet-id-here